// Write a program to find the roots of a quadratic equation and categorize them.
#include <stdio.h>
#include <math.h>

int main() {
    int a, b, c, d, alpha, beta;

    printf("Enter a, b, and c: ");
    scanf("%d %d %d", &a, &b, &c);

    d = b * b - 4 * a * c;

    if (d > 0) {
        alpha = (-b + sqrt(d)) / (2 * a);
        beta = (-b - sqrt(d)) / (2 * a);
        printf("Roots are Real and Distinct: %d, %d\n", alpha, beta);
    }
    else if (d == 0) {
        alpha = -b / (2 * a);
        printf("Roots are Real and Equal: %d\n", alpha);
    }
    else {
        printf("Roots are Complex and Imaginary.\n");
    }

    return 0;
}
