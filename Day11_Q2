// Write a program to find profit or loss percentage given cost price and selling price.
#include <stdio.h>
int main() {
    int CP, SP, loss, profit;
    printf("Enter CP, SP: ");
    scanf("%d %d", &CP, &SP);
    loss=CP-SP;
    profit=SP-CP;
    if (CP>SP)
        printf("Loss: %d", (loss*100)/CP);
    else if (SP>CP)
        printf("Profit: %d", (profit*100)/CP);
    else 
        printf("No Profit No Loss");
    return 0;
}
