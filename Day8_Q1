// Write a program to input a character and check whether its an uppercase alphabet, lowercase alphabet, digit or a special character
#include <stdio.h>
 #include <ctype.h>
 int main() {
    char a;
    printf("Enter a: ");
    scanf("%c", &a);
    if (isupper(a))
        printf("Uppercase letter");
    else if (islower(a))
        printf("Lowercase letter");
    else if (isdigit(a))
        printf("Digit");
    else
        printf("Special Character");
    return 0;
    }
