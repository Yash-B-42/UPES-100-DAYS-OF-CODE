// Write an program to input an integer and check whether it is positive, negative or zero using nested if-else
#include <stdio.h>
int main() {
    int a;
    printf("Enter a: ");
    scanf("%d", &a);
    if ( a >= 0) {
        if ( a == 0 ) {
            printf("a is zero\n");
        } else {
            printf("a is positive\n");
        }
    } else {
        printf("The number is negative\n");
    }
return 0;
}
