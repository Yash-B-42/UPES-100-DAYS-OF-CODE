// Write a program to input a character and check whether it is a vowel or a consonant using if-else
#include <stdio.h>
int main() {
    char letter;
    printf("Enter letter: ");
    scanf("%c", &letter);
    if (letter == 'a' || letter == 'e' || letter == 'i' || letter == 'o' || letter == 'u')
        printf("letter is a vowel");
    else
        printf("letter is a consonant");
    return 0;
}
